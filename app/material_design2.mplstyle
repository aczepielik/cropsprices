# General Settings
axes.titlesize: 16         # Title font size
axes.titleweight: bold     # Title font weight
axes.titlelocation: left
axes.titlepad: 12
axes.labelsize: 10         # Label font size
axes.labelweight: medium   # Label font weight
axes.edgecolor: "#1d1d1d"    # Axis edge color
axes.grid: True
axes.linewidth: 0.8

# Colors
axes.prop_cycle: cycler('color', ["#4a8035", "#006978", "#a74e19", "#1f91ab", "#3e9c39", "#a02046", "#e39a23"])

# Font
font.family: sans-serif
font.sans-serif: Roboto, DejaVu Sans, Liberation Sans, Arial, sans-serif
font.size: 10

# Grid
grid.color: "#e0e0e0"        # Light grid lines
grid.linestyle: --         # Dashed grid lines
grid.linewidth: 0.6

# Tick Parameters
xtick.color: "#1d1d1d"
ytick.color: "#1d1d1d"
xtick.labelsize: 10
ytick.labelsize: 10

# Figure
figure.facecolor: "#ffffff"  # White background for Material Design
figure.edgecolor: "#ffffff"

# Subplot
figure.subplot.left: 0.1
figure.subplot.right: 0.9
figure.subplot.bottom: 0.1
figure.subplot.top: 0.9

# Lines and Markers
lines.linewidth: 2.0       # Standard line width
lines.markersize: 6        # Standard marker size

# Legend
legend.fontsize: 10
legend.frameon: True
legend.framealpha: 0.8     # Semi-transparent legend box
legend.loc: lower center
legend.borderaxespad: 1  # Space between plot and legend
legend.handletextpad: 0.5
legend.columnspacing: 1.0
legend.facecolor: "#FBFBFB"  # Light gray for contrast

# Savefig
savefig.dpi: 300           # High-resolution saves
savefig.transparent: True
savefig.format: svg

# Error Bars
errorbar.capsize: 3.0

# Colors for Positive/Negative Elements
text.color: "#1d1d1d"
axes.facecolor: "#FBFBFB"    # Light gray background for Material Design
#positive.color: "#4caf50"    # Positive elements (green)
#negative.color: "#b71c1c"    # Negative elements (red)
#warning.color: "#f9a825"     # Warnings (amber)
#info.color: "#29b6f6"        # Informational elements (cyan)
